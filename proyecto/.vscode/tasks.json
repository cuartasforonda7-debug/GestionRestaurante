{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar proyecto Java",
            "type": "process",
            "command": "javac",
            "args": [
                "-encoding",
                "UTF-8",
                "-cp",
                "lib\\mssql-jdbc-13.6.0.jre11.jar",
                "-d",
                "out",
                "src\\dominio\\entidades\\*.java",
                "src\\dominio\\seguridad\\*.java",
                "src\\dominio\\excepciones\\*.java",
                "src\\dominio\\puertos\\entrada\\*.java",
                "src\\dominio\\puertos\\salida\\*.java",
                "src\\app\\aplicacion\\servicios\\*.java",
                "src\\app\\backend\\infraestructura\\basedatos\\*.java",
                "src\\app\\backend\\infraestructura\\excepciones\\*.java",
                "src\\app\\backend\\infraestructura\\adaptadores\\*.java",
                "src\\app\\backend\\infraestructura\\adaptadores\\memoria\\*.java",
                "src\\app\\backend\\configuracion\\*.java",
                "src\\app\\backend\\presentacion\\controlador\\*.java",
                "src\\app\\backend\\pruebas\\*.java",
                "src\\app\\backend\\Aplicacion.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Ejecutar Usuarios y Roles (Épica 1)",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.pruebas.UsuarioEmpleadoPrueba"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        },
        {
            "label": "Ejecutar prueba Producto (Épica 2)",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.pruebas.ProductoServicePrueba"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        },
        {
            "label": "Ejecutar aplicación general",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.Aplicacion"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        }
    ]
}
